# ============================================================
#  Study Planner — configuración de despliegue (docker-compose.yml)
#  Copia este archivo a .env y rellena los valores.
# ============================================================

# --- Dominio / HTTPS -----------------------------------------
# :80                    → solo HTTP (pruebas en local, o detrás de Cloudflare Tunnel u otro proxy)
# estudio.midominio.com  → HTTPS automático (Let's Encrypt). El DNS debe apuntar al servidor
#                          y los puertos 80 y 443 deben estar abiertos.
SITE_ADDRESS=:80

# Puertos publicados en el host
HTTP_PORT=80
HTTPS_PORT=443

# --- MongoDB -------------------------------------------------
MONGO_ROOT_USER=admin
# Usa solo letras y números (va dentro de una URI). Genera una con: openssl rand -hex 24
MONGO_ROOT_PASSWORD=
MONGO_DB=study-planner

# --- Autenticación -------------------------------------------
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- API -----------------------------------------------------
# "*" = cualquier origen. O lista separada por comas: https://estudio.midominio.com
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info

# --- Escaneo de horarios (opcional) --------------------------
# Basta con UNA clave. Sin ninguna, el botón "Escanear horario" aparece
# desactivado y el horario se edita a mano.
# Gemini (https://aistudio.google.com/apikey) — se usa si está configurada
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modelos alternativos si el principal está saturado (en orden)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest
# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Forzar proveedor si hay varias claves: gemini | anthropic (vacío = automático)
SCAN_PROVIDER=
# Escaneos permitidos por hora y por IP (cada uno consume créditos de la API)
SCAN_RATE_LIMIT_MAX=15

# --- Notificaciones push (Web Push) ---
# Sin claves, la API las genera en el primer arranque y las guarda en MongoDB.
# Para fijarlas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (mailto: o https://).
VAPID_SUBJECT=mailto:avisos@study-planner.app
# Cada cuántos minutos se revisan los avisos programados.
NOTIFICACIONES_INTERVALO_MIN=5

# --- Cuenta demo ---
# Emails de cuentas de demostración (separados por comas): no pueden cambiar
# su nombre ni su email. Vacío = ninguna.
DEMO_EMAILS=

# --- Frontend ------------------------------------------------
# URL del API vista desde el navegador (se incrusta al compilar). "/api" = mismo dominio.
VITE_API_URL=/api
