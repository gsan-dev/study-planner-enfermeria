# Copia este archivo a backend/.env para desarrollo local SIN Docker.
# (Con Docker, las variables se definen en el .env de la raíz del proyecto.)

NODE_ENV=development
PORT=4000

# MongoDB local o MongoDB Atlas
MONGO_URI=mongodb://localhost:27017/study-planner

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# "*" = cualquier origen. O lista separada por comas: https://estudio.midominio.com,http://localhost:5173
CORS_ORIGINS=*

# Rate limiting (ventana en ms y máximo de peticiones por IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Número de proxies inversos delante de la API (0 en local, 1 detrás de Caddy)
TRUST_PROXY=0

# trace | debug | info | warn | error
LOG_LEVEL=debug

# Escaneo de horarios con IA (opcional). Basta con una clave; sin ninguna, se desactiva.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest
SCAN_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SCAN_RATE_LIMIT_MAX=15
