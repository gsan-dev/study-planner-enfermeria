# Copia a frontend/.env.local para desarrollo local sin Docker.

# URL del API vista desde el navegador. Por defecto "/api" (mismo dominio):
# en desarrollo Vite hace de proxy y en producción lo hace Caddy.
# Solo cámbiala si el API vive en otro dominio, p. ej. https://api.midominio.com/api
VITE_API_URL=/api

# (Solo desarrollo) A dónde redirige Vite las peticiones /api
VITE_PROXY_TARGET=http://localhost:4000

# (Solo desarrollo en Docker sobre Windows/macOS) detección de cambios por sondeo
# VITE_USE_POLLING=true
